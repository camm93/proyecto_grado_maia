# ════════════════════════════════════════════════════════════════════════════
#  MAIA v6 — Variables de entorno para el backend
# ════════════════════════════════════════════════════════════════════════════

# ─── Generales ──────────────────────────────────────────────────────────────
# MODELS_DIR y MANIFEST_PATH: por DEFAULT el start.sh infiere los paths
# desde el directorio donde corre uvicorn — `$(pwd)/models` y
# `$(pwd)/release_manifest.json`. Para la mayoria de deploys NO hace falta
# definirlos aqui. Si los descomentas, ASEGURATE de que apunten a paths
# REALES y ESCRIBIBLES por el usuario que corre el servicio (no a `/app/`
# salvo que estes en un contenedor Docker con ese mount). Bug historico
# (v7.8.2): tener `MODELS_DIR=/app/models` hardcoded hacia que el servicio
# systemd fallara con PermissionError al intentar crear /app/.
#
MODELS_DIR=/data/app/models
MANIFEST_PATH=/data/app/release_manifest.json

# ─── T1 SciBETO-ES (segmentación retórica) ──────────────────────────────────
T1_DEVICE=auto
T1_BATCH_SIZE=32
T1_PRELOAD=true
T1_PRELOAD_ID=scibeto-es-t1
T1_LOG_PREDICTIONS=false
T1_LOG_FULL_TEXT=false

# ─── T2 SciBETO-ES encoders (detección contribuciones) ──────────────────────
T2_DEVICE=auto
T2_BATCH_SIZE=32
T2_PRELOAD=true
T2_PRELOAD_ID=scibeto-es-t2
# Preload del modelo ablation (ctx) además del baseline:
T2_CTX_PRELOAD=true
T2_CTX_PRELOAD_ID=scibeto-es-t2-ctx
T2_THRESHOLD=0.5
T2_LOG_PREDICTIONS=false
T2_LOG_FULL_TEXT=false

# ─── LLMs T1 + T2 (A5 + A6 + A7 del PDF) ────────────────────────────────────
# OpenAI — necesario para gpt-4o-mini-t1 y gpt-4o-mini-t2(-fs8)
OPENAI_API_KEY=

# Llama 3.1 — necesario para llama-3.1-8b-t1 y llama-3.1-8b-t2(-fs8)
# El modelo es gated, hay que aceptar la licencia en HuggingFace antes.
HF_TOKEN=
LLAMA_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
LLAMA_ENABLED=true

# HuggingFace cache directory. HF guarda modelos descargados (Llama ~16 GB)
# en ~/.cache/huggingface por default — eso suele caer en el disco root del
# sistema operativo, que en VPS chicos (EC2 con AMI default = 8-30 GB) no
# alcanza para 16 GB. Para evitar problemas, apuntar HF_HOME a un dir dentro
# del proyecto (donde habría más espacio).
#
# Si no se setea aquí, main.py setea automáticamente:
#     <project_root>/models/.hf_cache
# (el mismo volumen donde viven los SciBETO — un solo disco grande para
#  todos los modelos descargables).
#
# Cambiar SOLO si tu volumen del proyecto tampoco tiene espacio y necesitás
# apuntar a otro disco montado (EBS adicional, etc).
HF_HOME=

# Preload de Llama al startup (default true — la app no responde hasta que
# termine la descarga + load). Tiempo de carga:
#   - GPU CUDA (g4dn.xlarge):  1-2 min   (4-bit, ~10 GB VRAM)
#   - CPU (Windows/Mac dev):  10-20 min  (FP16, ~16 GB RAM, descarga 16 GB)
# En máquinas con poca RAM (<32 GB), recomendado:
#   LLAMA_PRELOAD=false   → Llama se cargará lazy al primer request
LLAMA_PRELOAD=true

# CPU automatico para Llama: si no hay CUDA, el backend carga Llama en CPU
# FP16 (~16 GB RAM, 30-90s por inferencia). No requiere setear nada — es el
# comportamiento por default desde v6.1. La variable LLAMA_ALLOW_CPU del .env
# de versiones anteriores ya NO se usa (deprecada).

# Modelo GPT a usar (default gpt-4o-mini)
GPT_MODEL_NAME=gpt-4o-mini

# Log de respuestas crudas del LLM (debug, mucho ruido — solo en dev)
T2_LLM_LOG=false

# ─── Rate limiting (cap por sesión) ─────────────────────────────────────────
# Cap de requests por IP por hora. Aplica solo a /api/* (health/docs/static
# pasan sin contar). Sliding window. Default 1000. Para deshabilitar de hecho:
# setear un valor muy alto como 999999.
RATE_LIMIT_PER_HOUR=1000

# Whitelist de IPs que bypasean el limit (CSV). Útil para health checks
# internos del ALB, monitores, etc. Default: vacío.
RATE_LIMIT_WHITELIST=

# ─── Descarga de pesos desde Google Drive ───────────────────────────────────
# El sistema de descarga (backend/utils/model_sync.py) lee URLs desde el
# manifest. Ver MANIFEST_PATH arriba.
#
# Carpeta pública con los 3 ZIPs:
#   https://drive.google.com/drive/folders/1zAdw781nvc46oWOWbkHLDuKNJG9uzh6G
#
DOWNLOAD_MODELS_ON_START=true
DOWNLOAD_RETRY_ATTEMPTS=3
DOWNLOAD_TIMEOUT_SECONDS=600

# Política ante fallo definitivo de descarga o hash mismatch:
#   abort  → sys.exit(1), contenedor muere (failsafe)
#   warn   → loggea ERROR pero levanta uvicorn (modelo cae a fallback heurístico)
DOWNLOAD_FAIL_POLICY=abort

# ─── (LEGACY) Fuentes alternativas de descarga ──────────────────────────────
# Estas variables ya NO se usan en v6. El sistema nuevo usa Drive vía manifest.
# Mantener comentadas por si en versiones futuras se reactivan.
#
# HuggingFace Hub
# HF_REPO_T1=tu-org/scibeto-es-t1
# HF_REPO_T2=tu-org/scibeto-es-t2
# HF_REPO_T2_CTX=tu-org/scibeto-es-t2-ctx
#
# S3
# S3_BUCKET=maia-models
# S3_PREFIX_T1=scibeto-es-t1/
# S3_PREFIX_T2=scibeto-es-t2/
# S3_PREFIX_T2_CTX=scibeto-es-t2-ctx/
