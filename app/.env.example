# ============================================================
# MAIA — Variables de entorno
# Copia este archivo como .env y completa los valores
# ============================================================

# Puerto en el que arranca el servidor (default: 8000)
PORT=8000

# Host (0.0.0.0 para producción, 127.0.0.1 para desarrollo local)
HOST=0.0.0.0

# Directorio de modelos entrenados (pesos .pt / .safetensors)
# Estructura esperada: models/<model-id>/config.json + model.safetensors
MODELS_DIR=./models

# ────────────────────────────────────────────────────────────
# T1 — Performance (device, batching, preload)
# ────────────────────────────────────────────────────────────
# Device de inferencia para T1 SciBETO. Opciones: auto, cuda, cpu
# - auto (default): usa cuda si está disponible, cpu si no
# - cuda: fuerza GPU; falla con warning a CPU si no hay cuda
# - cpu: fuerza CPU incluso si hay GPU disponible
T1_DEVICE=auto

# Tamaño del micro-batch para inferencia.
# - GPU: 32 es seguro para 8GB+ VRAM; subir a 64 si hay más VRAM
# - CPU: 8 funciona bien en la mayoría de máquinas; subir a 16 si hay >16GB RAM
# Sin override: 32 para GPU, 8 para CPU.
# T1_BATCH_SIZE=32

# Pre-cargar el modelo al startup del servidor (en vez de en el primer request).
# El primer usuario no espera 15-30s de carga de pesos.
# Cambiar a "false" si querés mantener el startup rápido (útil para Docker
# health checks estrictos en orquestadores).
T1_PRELOAD=true

# Modelo a pre-cargar (default: scibert-es)
T1_PRELOAD_ID=scibert-es

# ────────────────────────────────────────────────────────────
# T1 — Predictions logging (opcional)
# ────────────────────────────────────────────────────────────
# Si "true", cada predicción de /api/segment con scibert-es se loggea
# en backend/logs/t1_predictions_YYYY-MM-DD.jsonl (una línea por predicción).
# Por defecto NO se almacena el texto del input, solo un hash + metadata.
T1_LOG_PREDICTIONS=false

# Si "true", el log incluye el texto completo del input + neutralized.
# Usar SOLO en desarrollo. Genera logs grandes y puede tener implicaciones
# de privacidad.
T1_LOG_FULL_TEXT=false

# Directorio override para los logs (default: backend/logs)
# T1_LOG_DIR=/var/log/maia

# ────────────────────────────────────────────────────────────
# LLMs vía API (pendiente, A6/A7)
# ────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GOOGLE_API_KEY=
